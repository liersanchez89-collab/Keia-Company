# Copia este archivo como .env (para probar en tu ordenador) y pon tus datos.
# En Vercel se ponen en Settings → Environment Variables.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: para leer facturas y extractos en PDF con IA (console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcional: solo si queréis traer horas antiguas de Clockify
CLOCKIFY_KEY=
VITE_CLOCKIFY_WS=
